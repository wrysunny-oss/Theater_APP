/** SDK 初始化参数。初始化必须在用户同意隐私协议之后触发。 */
export type GroMoreInitOptions = {
  appId: string,
  appName: string,
  debug: boolean,
  /** true 表示限制个性化广告，对应平台 isLimitPersonalAds。 */
  limitPersonalAds: boolean,
  /** 是否开启程序化广告推荐。 */
  programmaticRecommend: boolean
}

/** 激励视频请求参数；userId 会原样出现在 GroMore 服务端奖励回调中。 */
export type GroMoreRewardOptions = {
  placementId: string,
  userId: string,
  rewardName: string,
  rewardAmount: number,
  extra: string
}

export type GroMoreRewardResult = {
  placementId: string,
  completed: boolean,
  transactionId: string
}

export type GroMoreSuccess = () => void
export type GroMoreRewardSuccess = (result: GroMoreRewardResult) => void
export type GroMoreFailure = (code: string, message: string, nativeCode: number) => void
